#import "@preview/polylux:0.4.0": *
#import "@preview/cades:0.3.1": qr-code
#import "@preview/metropolis-polylux:0.1.0" as metropolis
#import metropolis: new-section, focus

#show: metropolis.setup

#slide[
  #set page(header: none, footer: none, margin: 3em)

 
  #text(size: 1.3em)[
    *Donut-Klicker*
  ]

  #text(size: 1em)[
    *Spieleentwicklung*
  ]

  #metropolis.divider
  
  #set text(size: .8em, weight: "light")
  Version 2.0
]

#slide[
  = Ablauf

  #metropolis.outline
]

#new-section[Spieletest: Donut Klicker]

#slide[
  = Wie funktioniert ein Klickerspiel?

  #align(center)[
    #image("klickerspiel.png", width: 15em)
  ]
]

#slide[
  = Donut Klicker v0

  #align(center)[
    #image("donutv0.png", width: 18em)
  ]
]

#slide[
  = Donut Klicker v0

  #columns(2)[
    #align(center)[
      #image("donutv0.png")
    ]

    #colbreak()

    #text(size: 1.2em)[
      Ich brauche dein Feedback! Wie gefällt dir das Spiel?
    ]

    1. Gehe auf *informatik.openpatch.org* auf die Seite *6 (2025/2026)*.
    2. Gib bei Donut-Klicker v0 das Passwort *dda* ein.
    3. Spiele das Spiel und probiere alle Funktionen aus.
    4. Überlege, was man verbessern könnte.
  ]
]

#slide[
  = Donut Klicker v1

  #align(center)[
    #image("donutv1.png", width: 18em)
  ]
]

#slide[
  = Donut Klicker v1

  #columns(2)[
    #align(center)[
      #image("donutv1.png")
    ]

    #colbreak()

    #text(size: 1.2em)[
      Finde heraus, was sich im Vergleich zur vorherigen Version geändert hat!
    ]

    1. Gehe auf *informatik.openpatch.org* auf die Seite *6 (2025/2026)*.
    2. Gib bei Donut-Klicker v1 das Passwort *dkd* ein.
    3. Spiele das Spiel und probiere alle Funktionen aus.
    4. Notiere dir die Unterschiede zur vorherigen Version.
  ]
]

#slide[
  = Was wurde geändert?

  #image("donutv1.png", width: 18em)
]

#new-section[Dein Klicker]

#slide[
  = Du bist dran! Was möchtest du verändern?

  #columns(2)[
    #align(center)[
      #image("donutv1.png")
    ]

    #colbreak()

    #text(size: 1.1em)[
      Überlege, was du im Spiel verändern möchtest!
    ]

    1. Welche Funktionen möchtest du hinzufügen oder ändern?
    2. Schreibe deine Ideen auf!
    3. Gib bei *Dein Donut Klicker* das Passwort *ddd* ein.
    3. Versuche, deine Ideen im Spiel umzusetzen!
    4. Bereite dich auf eine kurze Vorstellung vor.
  ]
]

#new-section[Projekte speichern]

#slide[
  = Projekte speichern

  1. Datei-Icon -> Auf deinem Computer speichern
  2. Auf der linken Seite dein Verzeichnis anklicken
  3. Oben links auf Speichern klicken
]
